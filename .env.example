# Copia este archivo como .env.local (local) y configura lo mismo en Vercel (producción).
# Nunca subas los valores reales a git.

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Solo servidor. La usan los webhooks de pago para actualizar suscripciones.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Sitio ────────────────────────────────────────────────
# Por defecto https://averotechnology.com (sitio y /admin) e https://inventario.averotechnology.com
# (sistema de los clientes). En local pon los dos en http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://averotechnology.com
# NEXT_PUBLIC_APP_URL=https://inventario.averotechnology.com
# Solo producción: comparte la sesión entre los dos dominios para que /admin funcione.
# NEXT_PUBLIC_COOKIE_DOMAIN=.averotechnology.com

# ── PayPal (cobro automático de suscripciones) ──────────
# developer.paypal.com → Apps & Credentials: crea una app (Sandbox para probar, Live para cobrar).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Los genera scripts/paypal-setup.mjs (planes con y sin prueba, y el webhook).
PAYPAL_PLAN_MONTHLY=
PAYPAL_PLAN_ANNUAL=
PAYPAL_PLAN_MONTHLY_NO_TRIAL=
PAYPAL_PLAN_ANNUAL_NO_TRIAL=
PAYPAL_WEBHOOK_ID=

# ── Correo: aviso 3 días antes de que termine la prueba (PayPal no lo envía) ──
# resend.com: crea una API key y verifica el dominio averotechnology.com.
RESEND_API_KEY=
EMAIL_FROM=Avero Technology <avisos@averotechnology.com>
# Vercel la manda en la tarea diaria (vercel.json); usa un valor largo y aleatorio.
CRON_SECRET=

# ── Asistente de ventas por WhatsApp (docs/whatsapp-setup.md, ADR-003) ──
# OpenAI: platform.openai.com → API keys. Pago por uso; pon un tope en Limits.
OPENAI_API_KEY=
# Modelo de la conversación y de las notas de voz (cámbialos sin tocar código).
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Meta → tu app → WhatsApp → Configuración de la API: token permanente de un usuario del sistema
# (no el temporal de 24 h) y el identificador del número.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta → tu app → Configuración → Básica → Clave secreta de la app. Firma cada webhook.
WHATSAPP_APP_SECRET=
# Lo inventas tú (largo y aleatorio) y lo pegas igual en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Número del bot, solo dígitos con código de país (ej. 18095550123).
WHATSAPP_BOT_NUMBER=
# Números de prueba separados por coma: sus pedidos salen marcados como "Prueba".
WHATSAPP_TEST_NUMBERS=
# Tu WhatsApp personal: ahí llegan los avisos de pedidos confirmados (plantilla aprobada).
OWNER_WHATSAPP=
# Copia de cada aviso por correo (usa RESEND_API_KEY de arriba).
LEADS_NOTIFY_EMAIL=info@averotechnology.com
# Tope de gasto de IA por día en US$. Al llegar, el bot pasa los chats a una persona.
AI_DAILY_BUDGET_USD=2
# Lo que el bot dice sobre pagos y entregas (texto libre).
BOT_PAYMENT_METHODS=efectivo contra entrega o transferencia bancaria
BOT_DELIVERY_INFO=Coordinamos la entrega por este chat después de confirmar el pedido.

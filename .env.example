# Copia este archivo como .env.local (local) y configura lo mismo en Vercel (producción).
# Nunca subas los valores reales a git.

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Solo servidor. La usan los webhooks de pago para actualizar suscripciones.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Sitio ────────────────────────────────────────────────
# Opcional: por defecto https://averotechnology.com
# NEXT_PUBLIC_SITE_URL=https://averotechnology.com

# ── Lemon Squeezy (cobro automático de suscripciones) ────
# Settings → API: crea una API key (en modo prueba primero).
LEMONSQUEEZY_API_KEY=
# Settings → Stores: el ID numérico de tu tienda.
LEMONSQUEEZY_STORE_ID=
# Settings → Webhooks: el "signing secret" que escribiste al crear el webhook.
LEMONSQUEEZY_WEBHOOK_SECRET=
# IDs de las variantes del producto "Sistema de gestión" CON prueba gratis.
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_ANNUAL=
# Mismas variantes SIN prueba, para quien ya usó la suya o reactiva una cuenta vencida.
LEMONSQUEEZY_VARIANT_MONTHLY_NO_TRIAL=
LEMONSQUEEZY_VARIANT_ANNUAL_NO_TRIAL=
